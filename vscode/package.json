  "keywords": ["theme", "dark", "light", "clay", "brick", "slate"],
  "contributes": {
    "themes": [
      { "id": "barro-slate", "label": "Barro Slate", "uiTheme": "vs-dark", "path": "./themes/barro-slate.json" },
      { "id": "barro-kaolin", "label": "Barro Kaolin", "uiTheme": "vs", "path": "./themes/barro-kaolin.json" }
